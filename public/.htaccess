# ══════════════════════════════════════════════════════════════════════
#  Seguridad · Comunidad Cristiana Renacer  (Apache / cPanel)
#  Este archivo sale del build (public/) hacia public_html/.
# ══════════════════════════════════════════════════════════════════════

# ── Forzar HTTPS ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Cabeceras de seguridad ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  # HSTS: obliga HTTPS por 1 año. Deja tu SSL (AutoSSL de cPanel) activo antes.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Política de contenido (CSP). Permite solo los orígenes que el sitio usa:
  #   - Cloudflare Turnstile (captcha)   - YouTube (embeds/miniaturas)
  #   - Google Fonts                     - Facebook (embeds del live)
  # Si agregas otro servicio externo (analytics, mapa, etc.) añádelo aquí.
  # CSP pragmática: permite recursos de terceros por HTTPS (YouTube, Facebook,
  # Instagram/Elfsight, Cloudflare, Google Fonts) sin tener que enumerar cada
  # dominio, PERO conserva las protecciones críticas:
  #   frame-ancestors 'self'  → nadie puede incrustar tu sitio (anti-clickjacking)
  #   form-action 'self'      → el formulario solo puede enviar a tu propio dominio
  #   object-src 'none'       → sin plugins Flash/obsoletos
  #   base-uri 'self'         → sin secuestro de <base>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src 'self' https:; connect-src 'self' https:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# ── Proteger el config con secretos y la plantilla ──
<FilesMatch "^config(\.example)?\.php$">
  Require all denied
</FilesMatch>

# ── Bloquear la carpeta de datos del rate-limit ──
RedirectMatch 404 ^/\.data(/.*)?$

# ── Bloquear archivos ocultos y de respaldo ──
<FilesMatch "(^\.(?!well-known)|\.(bak|old|log|ini|sql|env)$)">
  Require all denied
</FilesMatch>

# ── Evitar listado de directorios ──
Options -Indexes
