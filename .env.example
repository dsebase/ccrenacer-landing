# ───────────────────────────────────────────────────────────────
# CONFIGURACIÓN · Comunidad Cristiana Renacer
# Copiá este archivo como ".env" y completá con tus datos reales.
# Tras editar el .env hay que reiniciar "pnpm dev" (o volver a desplegar).
# ───────────────────────────────────────────────────────────────

# URL del sistema admin (subdominio)
PUBLIC_SISTEMA_URL=https://sistema.ccrenacer.com

# ── Conexión con el ERP (contenido dinámico: IECs y eventos) ──
# Cuando el ERP esté online, pon aquí su API pública y el sitio tomará
# solo las IECs y eventos marcados "Mostrar en la web" (sin recompilar nada
# más que este build). Si queda vacío, el sitio usa los datos fijos (fallback).
#   Ejemplo:  PUBLIC_ERP_API_URL=https://sistema.ccrenacer.com/api
PUBLIC_ERP_API_URL=

# ── Seguridad del formulario · Cloudflare Turnstile (captcha) ──
# Clave PÚBLICA (site key). Se saca en dash.cloudflare.com → Turnstile.
# La clave SECRETA va en el config.php del hosting, NO acá.
# Sin esta variable el captcha no aparece y los envíos serán rechazados.
PUBLIC_TURNSTILE_SITE_KEY=

# ── Redes sociales (los botones y links del sitio apuntan acá) ──
PUBLIC_FACEBOOK_URL=https://facebook.com/TU_PAGINA
PUBLIC_INSTAGRAM_URL=https://instagram.com/TU_USUARIO
PUBLIC_YOUTUBE_URL=https://youtube.com/@TU_CANAL
PUBLIC_WHATSAPP_URL=https://wa.me/51TUNUMERO

# ── YouTube automático (página /en-vivo) ──
# ID del canal (empieza con "UC..."). Con esto, la tira de YouTube trae SOLA
# los últimos videos con su miniatura real, sin tener que cargarlos a mano.
# Dónde encontrarlo: YouTube Studio → Configuración → Canal → Configuración
# avanzada → "ID del canal".  (o ver INTEGRACIONES.md)
PUBLIC_YOUTUBE_CHANNEL_ID=

# API key de YouTube Data API v3 (para la tira "Últimos videos" de /en-vivo).
# Créala en console.cloud.google.com, habilita "YouTube Data API v3", y
# restríngela a tu dominio (HTTP referrers). Es pública (segura de exponer).
PUBLIC_YOUTUBE_API_KEY=

# ── Facebook Live (página /en-vivo) ──
# Cuando vayan a transmitir, pegá la URL del video en vivo y poné LIVE_NOW=true.
# La URL es la del post/video del live, ej:
#   https://www.facebook.com/TU_PAGINA/videos/1234567890
PUBLIC_FB_VIDEO_HREF=
PUBLIC_FB_LIVE_NOW=false
