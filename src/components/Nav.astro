---
const sistemaUrl = import.meta.env.PUBLIC_SISTEMA_URL ?? "https://sistema.ccrenacer.com"
const facebook = import.meta.env.PUBLIC_FACEBOOK_URL ?? "https://facebook.com/ccrenacer"
const instagram = import.meta.env.PUBLIC_INSTAGRAM_URL ?? "https://instagram.com/ccrenacer"
const youtube = import.meta.env.PUBLIC_YOUTUBE_URL ?? "https://youtube.com/@ccrenacer"

const links = [
  { href: "/#manifiesto", label: "Manifiesto", n: "01" },
  { href: "/#vision", label: "Visión", n: "02" },
  { href: "/#proceso", label: "Renacer", n: "03" },
  { href: "/#ministerios", label: "Ministerios", n: "04" },
  { href: "/#servicios", label: "Servicios", n: "05" },
  { href: "/#contacto", label: "Contacto", n: "06" },
]
---

<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-500"
  data-nav
>
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <div
      data-nav-shell
      class="mt-5 flex items-center justify-between rounded-full border border-ink-900/8 bg-paper-50/70 px-5 py-3 backdrop-blur-xl transition-all duration-500"
    >
      <a href="/" class="flex items-center group ml-3 lg:ml-8">
        <img
          src="/logo_menu.png"
          alt="Comunidad Cristiana Renacer"
          class="h-11 lg:h-12 w-auto object-contain transition-all duration-500 group-hover:scale-[1.03] group-hover:brightness-0"
        />
      </a>

      <nav class="hidden lg:flex items-center gap-1 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-500">
        {links.map((l) => (
          <a href={l.href} class="link-underline px-3 py-1.5 hover:text-ink-900 transition-colors">
            {l.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-1.5 sm:gap-2 mr-3 lg:mr-8">
        <a href={facebook} target="_blank" rel="noopener" aria-label="Facebook" class="hidden sm:flex w-9 h-9 rounded-full items-center justify-center text-ink-900 hover:bg-[#1877F2] hover:text-white transition-colors duration-300" data-cursor="hover">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.88v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
        </a>
        <a href={instagram} target="_blank" rel="noopener" aria-label="Instagram" class="hidden sm:flex w-9 h-9 rounded-full items-center justify-center text-ink-900 hover:bg-[#E1306C] hover:text-white transition-colors duration-300" data-cursor="hover">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        </a>
        <a href={youtube} target="_blank" rel="noopener" aria-label="YouTube" class="hidden sm:flex w-9 h-9 rounded-full items-center justify-center text-ink-900 hover:bg-[#FF0000] hover:text-white transition-colors duration-300" data-cursor="hover">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.8-.5-5.6c-.3-1-1-1.8-2-2C18.8 4 12 4 12 4s-6.8 0-8.5.5c-1 .3-1.8 1-2 2C1 8.2 1 12 1 12s0 3.8.5 5.6c.3 1 1 1.8 2 2C5.2 20 12 20 12 20s6.8 0 8.5-.5c1-.3 1.8-1 2-2 .5-1.8.5-5.5.5-5.5zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
        </a>
        <button
          type="button"
          class="lg:hidden p-2 text-ink-900"
          aria-label="Abrir menú"
          data-mobile-toggle
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú mobile -->
  <div
    class="lg:hidden fixed inset-0 z-40 bg-paper-50/98 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-500"
    data-mobile-menu
  >
    <button
      type="button"
      class="absolute top-7 right-6 w-11 h-11 rounded-full border border-ink-900/15 flex items-center justify-center text-ink-900 active:bg-ink-900 active:text-paper-50 transition-colors"
      aria-label="Cerrar menú"
      data-mobile-close
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    <div class="flex flex-col items-center justify-center min-h-screen gap-6 overflow-y-auto py-20">
      <img src="/logo_menu.png" alt="Comunidad Cristiana Renacer" class="h-12 w-auto object-contain mb-8" />
      {links.map((l) => (
        <a href={l.href} class="font-display text-4xl text-ink-900 hover:text-spirit-500 transition-colors" data-mobile-link>
          {l.label}
        </a>
      ))}

      <div class="flex items-center gap-4 mt-10">
        <a href={facebook} target="_blank" rel="noopener" aria-label="Facebook" class="w-12 h-12 rounded-full border border-ink-900/15 flex items-center justify-center text-ink-900 active:bg-[#1877F2] active:text-white hover:bg-[#1877F2] hover:text-white transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.88v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
        </a>
        <a href={instagram} target="_blank" rel="noopener" aria-label="Instagram" class="w-12 h-12 rounded-full border border-ink-900/15 flex items-center justify-center text-ink-900 active:bg-[#E1306C] active:text-white hover:bg-[#E1306C] hover:text-white transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        </a>
        <a href={youtube} target="_blank" rel="noopener" aria-label="YouTube" class="w-12 h-12 rounded-full border border-ink-900/15 flex items-center justify-center text-ink-900 active:bg-[#FF0000] active:text-white hover:bg-[#FF0000] hover:text-white transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.8-.5-5.6c-.3-1-1-1.8-2-2C18.8 4 12 4 12 4s-6.8 0-8.5.5c-1 .3-1.8 1-2 2C1 8.2 1 12 1 12s0 3.8.5 5.6c.3 1 1 1.8 2 2C5.2 20 12 20 12 20s6.8 0 8.5-.5c1-.3 1.8-1 2-2 .5-1.8.5-5.5.5-5.5zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Pestaña lateral fija: acceso al sistema -->
  <a
    href={sistemaUrl}
    target="_blank"
    rel="noopener"
    aria-label="Acceder al sistema"
    class="group fixed right-0 top-32 lg:top-14 -translate-y-1/2 z-40 flex items-center gap-2 rounded-l-2xl bg-ink-900 text-paper-50 py-3 lg:py-3.5 pl-3.5 lg:pl-4 pr-2.5 lg:pr-3 shadow-xl shadow-ink-900/20 hover:bg-spirit-500 hover:text-ink-950 active:bg-spirit-500 active:text-ink-950 hover:pr-4 transition-all duration-400"
    data-cursor="hover"
  >
    <svg class="shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="3" width="20" height="14" rx="2" />
      <path d="M8 21h8M12 17v4" />
    </svg>
    <span class="max-w-0 overflow-hidden whitespace-nowrap font-mono text-[11px] uppercase tracking-[0.2em] opacity-0 transition-all duration-400 group-hover:max-w-[90px] group-hover:opacity-100">
      Sistema
    </span>
  </a>
</header>

<script>
  const nav = document.querySelector("[data-nav]") as HTMLElement | null
  const shell = document.querySelector("[data-nav-shell]") as HTMLElement | null
  const menu = document.querySelector("[data-mobile-menu]") as HTMLElement | null
  const toggle = document.querySelector("[data-mobile-toggle]") as HTMLElement | null
  const links = document.querySelectorAll("[data-mobile-link]")

  if (shell) {
    const onScroll = () => {
      if (window.scrollY > 16) shell.classList.add("scrolled")
      else shell.classList.remove("scrolled")
    }
    window.addEventListener("scroll", onScroll, { passive: true })
    onScroll()
  }

  const closeMenu = () => {
    if (!menu) return
    menu.classList.remove("opacity-100", "pointer-events-auto")
    menu.classList.add("opacity-0", "pointer-events-none")
  }
  const openMenu = () => {
    if (!menu) return
    menu.classList.add("opacity-100", "pointer-events-auto")
    menu.classList.remove("opacity-0", "pointer-events-none")
  }
  toggle?.addEventListener("click", () => {
    if (menu?.classList.contains("opacity-100")) closeMenu()
    else openMenu()
  })
  const closeBtn = document.querySelector("[data-mobile-close]") as HTMLElement | null
  closeBtn?.addEventListener("click", closeMenu)
  links.forEach((l) => l.addEventListener("click", closeMenu))
</script>

<style>
  [data-nav-shell].scrolled {
    background: rgb(251 251 250 / 0.92);
    border-color: rgb(10 15 18 / 0.08);
    box-shadow: 0 8px 30px -10px rgb(10 15 18 / 0.08);
  }
</style>
