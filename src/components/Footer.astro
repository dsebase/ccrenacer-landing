---
import Marquee from "./Marquee.astro"

const sistemaUrl = import.meta.env.PUBLIC_SISTEMA_URL ?? "https://sistema.ccrenacer.com"
const instagram = import.meta.env.PUBLIC_INSTAGRAM_URL ?? "#"
const facebook = import.meta.env.PUBLIC_FACEBOOK_URL ?? "#"
const youtube = import.meta.env.PUBLIC_YOUTUBE_URL ?? "#"
const whatsapp = import.meta.env.PUBLIC_WHATSAPP_URL ?? "#"

const year = new Date().getFullYear()
---

<footer class="relative bg-ink-950 text-paper-100 grain grain-dark">
  <Marquee variant="dark" />

  <div class="mx-auto max-w-[1400px] px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid lg:grid-cols-[1.5fr_1fr_1fr_1fr] gap-10 lg:gap-16">
      <div>
        <img
          src="/logo_h.png"
          alt="Comunidad Cristiana Renacer"
          class="h-20 lg:h-24 w-auto object-contain object-left -ml-2 lg:-ml-4"
        />
        <p class="mt-6 text-ink-300 max-w-sm leading-relaxed text-pretty">
          El reflejo del amor y comunidad de Cristo. Una familia que renace
          cada día para ver el Reino.
        </p>
      </div>

      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-spirit-400 mb-5">/ Explora</p>
        <ul class="space-y-3 text-ink-200 text-sm">
          <li><a href="/#manifiesto" class="link-underline" data-cursor="hover">Manifiesto</a></li>
          <li><a href="/#proceso" class="link-underline" data-cursor="hover">Proceso Renacer</a></li>
          <li><a href="/#vision" class="link-underline" data-cursor="hover">Visión</a></li>
          <li><a href="/#servicios" class="link-underline" data-cursor="hover">Servicios</a></li>
          <li><a href="/#ministerios" class="link-underline" data-cursor="hover">Ministerios</a></li>
        </ul>
      </div>

      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-spirit-400 mb-5">/ Conecta</p>
        <ul class="space-y-3 text-ink-200 text-sm">
          <li><a href="/agenda" class="link-underline" data-cursor="hover">Agenda</a></li>
          <li><a href="/#ubicaciones" class="link-underline" data-cursor="hover">Ubicaciones</a></li>
          <li><a href="/#dar" class="link-underline" data-cursor="hover">Dar / Ofrenda</a></li>
          <li><a href="/#contacto" class="link-underline" data-cursor="hover">Contacto</a></li>
          <li><a href={sistemaUrl} target="_blank" rel="noopener" class="link-underline" data-cursor="hover">Sistema interno</a></li>
        </ul>
      </div>

      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-spirit-400 mb-5">/ Síguenos</p>
        <ul class="space-y-3 text-ink-200 text-sm">
          <li><a href={instagram} target="_blank" rel="noopener" class="link-underline" data-cursor="hover">Instagram ↗</a></li>
          <li><a href={facebook} target="_blank" rel="noopener" class="link-underline" data-cursor="hover">Facebook ↗</a></li>
          <li><a href={youtube} target="_blank" rel="noopener" class="link-underline" data-cursor="hover">YouTube ↗</a></li>
          <li><a href={whatsapp} target="_blank" rel="noopener" class="link-underline" data-cursor="hover">WhatsApp ↗</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-20 pt-8 border-t border-ink-700 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-ink-400">
        {year} · CCRENACER · Lima · Perú
      </p>
      <p class="font-display italic text-ink-200 text-lg">
        Juan 3:3 · Renace para ver el Reino.
      </p>
    </div>

    <p class="mt-10 text-center font-mono text-[10px] uppercase tracking-[0.3em] text-ink-400">
      Comunidad Cristiana Renacer © Todos Los Derechos Reservados.
    </p>
  </div>
</footer>
