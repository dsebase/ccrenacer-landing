---
import { images } from "../lib/images"
import AgendaCalendar from "./AgendaCalendar.tsx"

const servicios = [
  {
    dia: "Domingo",
    hora: "09:00",
    periodo: "a.m.",
    nombre: "Servicio Familiar",
    img: images.servicio1,
    destacado: true,
    zoom: false,
  },
  {
    dia: "Domingo",
    hora: "11:00",
    periodo: "a.m.",
    nombre: "Servicio de Jóvenes",
    img: images.servicio4,
    destacado: false,
    zoom: false,
  },
  {
    dia: "Miércoles",
    hora: "19:00",
    periodo: "p.m.",
    nombre: "Casa de Oración",
    img: images.servicio3,
    destacado: false,
    zoom: false,
  },
  {
    dia: "Miércoles y Viernes",
    hora: "05:00",
    periodo: "a.m.",
    nombre: "Amanecer con el Espíritu Santo",
    img: images.servicio2,
    destacado: false,
    zoom: true,
  },
]
---

<section id="servicios" class="relative py-32 lg:py-44 bg-paper-100">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <div class="grid lg:grid-cols-[1fr_1fr] gap-10 lg:gap-20 mb-16 items-end">
      <div>
        <p class="eyebrow mb-6">
          <span>03 · Actividades Renacer</span>
        </p>
        <h2 class="font-display font-light text-[clamp(2.5rem,6vw,6rem)] leading-[1] text-ink-900 tracking-[-0.025em] text-balance">
          Hay un lugar.<br />
          <span class="italic text-spirit-500">Esta semana.</span>
        </h2>
      </div>
      <p class="text-ink-500 text-lg max-w-md leading-relaxed">
        Si es tu primera vez, te esperamos con un equipo dedicado a recibirte.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {servicios.map((s) => (
        <article
          class="relative group overflow-hidden rounded-[28px] h-[420px]"
          data-cursor="hover"
        >
          <img
            src={s.img}
            alt={s.nombre}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/85 via-ink-950/30 to-transparent"></div>

          <div class="relative h-full flex flex-col justify-between p-7 text-paper-50">
            {/* Fila superior: solo el badge de "Principal" / "Zoom" a la derecha. */}
            <div class="flex items-start justify-end gap-2 min-h-[28px]">
              {s.destacado ? (
                <span class="shrink-0 font-mono text-[10px] uppercase tracking-[0.3em] px-2 py-1 bg-spirit-500 text-ink-950 rounded-full">
                  Principal
                </span>
              ) : s.zoom ? (
                <span class="shrink-0 inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.2em] px-2 py-1 bg-[#2D8CFF] text-white rounded-full">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 10l4.55-2.28A1 1 0 0 1 21 8.62v6.76a1 1 0 0 1-1.45.9L15 14M3 6h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/></svg>
                  Zoom
                </span>
              ) : null}
            </div>

            {/* Bloque inferior: día grande arriba de la hora + nombre del servicio. */}
            <div>
              <p class="font-display font-bold text-3xl lg:text-4xl leading-none tracking-[-0.02em] text-paper-50 mb-1">
                {s.dia}
              </p>
              <p class="font-display leading-none mb-2 tracking-[-0.02em]">
                <span class="text-5xl lg:text-6xl">{s.hora}</span>
                <span class="text-xl lg:text-2xl ml-1">{s.periodo}</span>
              </p>
              <p class="font-display italic text-2xl text-spirit-300 leading-tight">
                {s.nombre}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Cierre: enlace a la agenda completa (calendario con todas las actividades) */}
    <div class="mt-16 lg:mt-24 border-t border-ink-900/10 pt-12 lg:pt-16 grid lg:grid-cols-[auto_1fr_auto] gap-8 lg:gap-16 lg:items-center">
      <p class="eyebrow shrink-0">
        <span>Todo el mes</span>
      </p>
      <p class="font-display font-light text-2xl lg:text-3xl text-ink-900 leading-[1.2] text-balance max-w-2xl">
        Encuentros de oración, eventos y <span class="italic text-spirit-500">conferencias</span> a lo largo del mes.
      </p>
      <button
        type="button"
        data-agenda-open
        aria-haspopup="dialog"
        aria-controls="agenda-modal"
        class="btn-outline shrink-0 self-start lg:self-center"
        data-cursor="hover"
      >
        <span>Ver agenda completa</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  {/* Modal de agenda completa — usa <dialog> nativo (backdrop, foco atrapado y
      cierre con Esc incluidos). Se abre con el botón "Ver agenda completa". */}
  <dialog id="agenda-modal" aria-label="Agenda completa de la iglesia">
    <div class="agenda-scroll min-h-full w-full flex items-start sm:items-center justify-center p-4 sm:p-6">
      <div class="agenda-panel relative w-full max-w-[1100px] max-h-[92dvh] overflow-y-auto rounded-[28px] bg-paper-50 shadow-2xl shadow-black/40 ring-1 ring-ink-900/10">
        {/* Cabecera fija */}
        <div class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-ink-900/10 bg-paper-50/95 px-6 sm:px-8 py-5 backdrop-blur">
          <div>
            <p class="eyebrow mb-1"><span>Agenda Renacer</span></p>
            <p class="font-display text-xl sm:text-2xl text-ink-900 tracking-[-0.02em] leading-none">
              Toda la vida <span class="italic text-spirit-500">de la iglesia.</span>
            </p>
          </div>
          <button
            type="button"
            data-agenda-close
            aria-label="Cerrar agenda"
            class="shrink-0 flex h-11 w-11 items-center justify-center rounded-full border border-ink-900/15 text-ink-500 transition-colors hover:bg-ink-900 hover:text-paper-50"
            data-cursor="hover"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="p-6 sm:p-8">
          <AgendaCalendar client:load />
        </div>
      </div>
    </div>
  </dialog>
</section>

<style>
  #agenda-modal {
    padding: 0;
    border: none;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    background: transparent;
    overflow: visible;
  }
  #agenda-modal::backdrop {
    background: rgba(10, 12, 16, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  /* Apertura */
  #agenda-modal[open]:not(.is-closing) { animation: agenda-fade 0.55s cubic-bezier(0.33, 1, 0.68, 1); }
  #agenda-modal[open]:not(.is-closing)::backdrop { animation: agenda-fade 0.55s ease; }
  #agenda-modal[open]:not(.is-closing) .agenda-panel { animation: agenda-pop 0.65s cubic-bezier(0.33, 1, 0.68, 1); }

  /* Cierre — reverso suave con el mismo easing que la apertura */
  #agenda-modal.is-closing { animation: agenda-fade-out 0.5s cubic-bezier(0.33, 1, 0.68, 1) forwards; }
  #agenda-modal.is-closing::backdrop { animation: agenda-fade-out 0.5s ease forwards; }
  #agenda-modal.is-closing .agenda-panel { animation: agenda-pop-out 0.55s cubic-bezier(0.33, 1, 0.68, 1) forwards; }

  @keyframes agenda-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes agenda-fade-out { from { opacity: 1; } to { opacity: 0; } }
  @keyframes agenda-pop {
    from { opacity: 0; transform: translateY(24px) scale(0.99); }
    to { opacity: 1; transform: none; }
  }
  @keyframes agenda-pop-out {
    from { opacity: 1; transform: none; }
    to { opacity: 0; transform: translateY(24px) scale(0.99); }
  }
  /* Bloquea el scroll del fondo mientras el modal está abierto */
  html:has(#agenda-modal[open]) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    #agenda-modal[open]:not(.is-closing),
    #agenda-modal[open]:not(.is-closing) .agenda-panel,
    #agenda-modal.is-closing,
    #agenda-modal.is-closing .agenda-panel { animation: none; }
  }
</style>

<script>
  const dlg = document.getElementById("agenda-modal") as HTMLDialogElement | null
  if (dlg) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)")
    let closing = false

    // Cierre animado: reproduce el reverso y recién entonces cierra el <dialog>.
    const closeAgenda = () => {
      if (closing) return
      if (reduce.matches) {
        dlg.close()
        return
      }
      closing = true
      dlg.classList.add("is-closing")
      const panel = dlg.querySelector<HTMLElement>(".agenda-panel")
      let done = false
      const finish = () => {
        if (done) return
        done = true
        dlg.classList.remove("is-closing")
        closing = false
        dlg.close()
      }
      panel?.addEventListener("animationend", finish, { once: true })
      window.setTimeout(finish, 700) // red de seguridad si no dispara animationend
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-agenda-open]")
      .forEach((b) => b.addEventListener("click", () => dlg.showModal()))
    dlg
      .querySelector<HTMLButtonElement>("[data-agenda-close]")
      ?.addEventListener("click", closeAgenda)
    // Cerrar al hacer clic fuera del panel (sobre el backdrop / zona vacía)
    dlg.addEventListener("click", (e) => {
      const panel = dlg.querySelector(".agenda-panel")
      if (panel && !panel.contains(e.target as Node)) closeAgenda()
    })
    // Tecla Esc: animamos el cierre en vez del cierre instantáneo nativo
    dlg.addEventListener("cancel", (e) => {
      e.preventDefault()
      closeAgenda()
    })
  }
</script>
