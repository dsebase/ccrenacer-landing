---
// Cuentas bancarias oficiales de la iglesia + QR para pagos móviles.
// Editables aquí — placeholders "XXXX" reemplazables cuando llegue el dato oficial.
const cuentas = [
  {
    id: "bbva-soles",
    banco: "BBVA",
    tipo: "Cuenta Corriente Soles",
    moneda: "S/",
    numero: "0011-0118-0100043140",
    cci: "011-118-000100043140-71",
  },
  {
    id: "bbva-dolares",
    banco: "BBVA",
    tipo: "Cuenta Corriente Dólares",
    moneda: "US$",
    numero: "0011-0118-0100043159",
    cci: "011-118-000100043159-71",
  },
]

// Ruta del QR real de la iglesia.
const qrSrc = "/img/qr_rncr.png"
const qrNumero = "+51 931 797 790"
---

<section id="dar" class="relative py-32 lg:py-44 bg-ink-950 text-paper-50 overflow-hidden grain grain-dark">
  {/* Resplandor para dar profundidad al fondo oscuro */}
  <div class="absolute inset-0 -z-0 opacity-80">
    <div class="aurora-liquid aurora-strong"></div>
  </div>

  <div class="relative mx-auto max-w-[1400px] px-6 lg:px-10">
    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-16 lg:gap-24 items-start">
      <div>
        <p class="eyebrow eyebrow-light mb-6">
          <span>08 · Dar · Ofrenda</span>
        </p>
        <h2 class="font-display font-light text-[clamp(2.5rem,6vw,6rem)] leading-[1] text-paper-50 tracking-[-0.025em] text-balance">
          Sembramos<br />
          <span class="italic text-spirit-400">para el Reino.</span>
        </h2>
        <p class="mt-8 text-paper-100/70 text-lg max-w-md leading-relaxed">
          Tu ofrenda sostiene la misión y el alcance de Renacer. Cada siembra
          es semilla en vidas que están por renacer.
        </p>

        <p class="mt-12 font-display italic text-lg text-paper-100/70 max-w-md leading-relaxed border-l-2 border-spirit-400 pl-5">
          "Dios ama al dador alegre."
          <span class="block font-mono not-italic text-[10px] uppercase tracking-[0.3em] text-paper-100/45 mt-2">
            2 Corintios 9:7
          </span>
        </p>
      </div>

      <div class="grid gap-4">
        {/* Cabecera compartida: BBVA Soles + BBVA Dólares como títulos lado a lado */}
        <div class="grid sm:grid-cols-2 gap-4 border-b border-paper-50/10 pb-3">
          {cuentas.map((c) => (
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center justify-center min-w-[42px] px-2 py-0.5 rounded-full bg-spirit-500 text-ink-950 font-mono text-[10px] font-bold tracking-[0.15em]">
                {c.moneda}
              </span>
              <div class="min-w-0">
                <p class="font-display text-lg lg:text-xl text-paper-50 tracking-[-0.01em] leading-none">
                  {c.banco} <span class="text-paper-100/60 font-light">{c.tipo.replace('Cuenta Corriente ', '')}</span>
                </p>
              </div>
            </div>
          ))}
        </div>

        {/* Cuentas BBVA (números + CCI + botón copiar) */}
        <div class="grid sm:grid-cols-2 gap-4">
          {cuentas.map((c) => (
            <article class="bento bento-dark p-6 lg:p-7" data-cursor="hover">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <p class="font-mono text-[9px] uppercase tracking-[0.3em] text-paper-100/45 mb-1.5">
                    Cta. Corriente
                  </p>
                  <p class="font-display text-lg lg:text-xl text-paper-50 tracking-[-0.02em] whitespace-nowrap tabular-nums">
                    {c.numero}
                  </p>
                  <div class="mt-4 pt-4 border-t border-paper-50/10">
                    <p class="font-mono text-[9px] uppercase tracking-[0.3em] text-paper-100/45 mb-1">CCI</p>
                    <p class="text-xs text-paper-100/75 whitespace-nowrap tabular-nums">{c.cci}</p>
                  </div>
                </div>
                <button
                  type="button"
                  data-copy={c.numero}
                  class="shrink-0 w-11 h-11 rounded-full border border-paper-50/20 flex items-center justify-center text-paper-100 hover:bg-spirit-500 hover:text-ink-950 hover:border-spirit-500 transition-all"
                  aria-label={`Copiar ${c.numero}`}
                  data-cursor="hover"
                >
                  <svg class="i-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="9" y="9" width="13" height="13" rx="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                  <svg class="i-check hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </button>
              </div>
            </article>
          ))}
        </div>

        {/* Bloque QR — pago móvil (simplificado) */}
        <article class="bento bento-dark p-7 lg:p-8 grid sm:grid-cols-[auto_1fr] gap-6 sm:gap-8 items-center" data-cursor="hover">
          <div class="mx-auto sm:mx-0 w-40 h-40 sm:w-44 sm:h-44 rounded-2xl bg-paper-50 p-3 flex items-center justify-center shrink-0">
            <img
              src={qrSrc}
              alt="Código QR para ofrenda"
              class="w-full h-full object-contain qr-img"
              loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
            />
            <div class="hidden w-full h-full flex-col items-center justify-center gap-2 text-ink-400 text-center px-2">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
                <path d="M14 14h3v3h-3zM17 17h4v4h-4zM14 20h3" />
              </svg>
              <span class="font-mono text-[9px] uppercase tracking-[0.25em]">QR pendiente</span>
            </div>
          </div>

          <div class="min-w-0 text-center sm:text-left">
            <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-spirit-300 mb-3">
              Pago móvil · QR
            </p>
            <p class="font-display text-2xl lg:text-3xl text-paper-50 tracking-[-0.02em]">
              {qrNumero}
            </p>
            <button
              type="button"
              data-copy={qrNumero}
              class="mt-4 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.25em] text-paper-100/85 hover:text-spirit-300 transition-colors"
              data-cursor="hover"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="9" y="9" width="13" height="13" rx="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
              Copiar número
            </button>
          </div>
        </article>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>("#dar [data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const value = btn.dataset.copy ?? ""
        try {
          await navigator.clipboard.writeText(value)
        } catch {
          const ta = document.createElement("textarea")
          ta.value = value
          ta.style.position = "fixed"
          ta.style.opacity = "0"
          document.body.appendChild(ta)
          ta.select()
          try { document.execCommand("copy") } catch {}
          document.body.removeChild(ta)
        }
        const copy = btn.querySelector(".i-copy")
        const check = btn.querySelector(".i-check")
        if (copy && check) {
          copy.classList.add("hidden")
          check.classList.remove("hidden")
          btn.classList.add("!bg-spirit-500", "!text-ink-950", "!border-spirit-500")
          setTimeout(() => {
            copy.classList.remove("hidden")
            check.classList.add("hidden")
            btn.classList.remove("!bg-spirit-500", "!text-ink-950", "!border-spirit-500")
          }, 1500)
        } else {
          const original = btn.innerHTML
          btn.innerHTML = "<span>Copiado ✓</span>"
          setTimeout(() => (btn.innerHTML = original), 1500)
        }
      })
    })
  </script>
</section>
