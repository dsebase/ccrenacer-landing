---
import { images } from "../lib/images"

// Sección informativa/experiencial de las Iglesias en Casa.
// El foco NO es listar las IECs, sino comunicar qué se vive en una.
const collage = [
  { src: images.iec1, alt: "Iglesia en Casa — momento de comunión", focal: "center 40%" },
  { src: images.iec2, alt: "Iglesia en Casa — palabra y reflexión",  focal: "center 40%" },
  { src: images.iec3, alt: "Iglesia en Casa — oración compartida",   focal: "center 40%" },
]

// Directorio de IECs — se muestra en el modal al hacer click en "Encontrar mi IEC".
// Estructura:
//   nombre   — nombre oficial de la IEC (ej. "IEC Vista Alegre")
//   lideres  — nombre(s) del/los líder(es), separados por " · " si son varios
//   distrito — distrito o zona geográfica de referencia
//   dia/hora — cuándo se reúnen
const iecs = [
  { nombre: "IEC Magdalena 1",                      lideres: "Jessica Freyre",                   distrito: "Magdalena",              dia: "Jueves",  hora: "8:00 p.m." },
  { nombre: "IEC Magdalena 2",                      lideres: "Julio Freyre",                     distrito: "Magdalena",              dia: "Jueves",  hora: "8:00 p.m." },
  { nombre: "IEC San Miguel",                       lideres: "Yamier Ruiz & Malena Olivos",      distrito: "San Miguel",             dia: "Viernes", hora: "8:00 p.m." },
  { nombre: "IEC Callao",                           lideres: "Francisco Huayna & Elvia Linares", distrito: "Callao",                 dia: "Viernes", hora: "8:30 p.m." },
  { nombre: "IEC San Juan de Lurigancho",           lideres: "Jesús Rivas",                      distrito: "San Juan de Lurigancho", dia: "Viernes", hora: "7:30 p.m." },
  { nombre: "IEC Comas",                            lideres: "Yamileth Bastidas",                distrito: "Comas",                  dia: "Viernes", hora: "7:00 p.m." },
  { nombre: "IEC Breña",                            lideres: "Rocío Quispe",                     distrito: "Breña",                  dia: "Jueves",  hora: "8:00 p.m." },
  { nombre: "IEC San Martín de Porres",             lideres: "Juana Huby",                       distrito: "San Martín de Porres",   dia: "Jueves",  hora: "8:00 p.m." },
  { nombre: "IEC Casa Blanca 1",                    lideres: "Juan Pablo Haro & Iris Pérez",     distrito: "Santiago de Surco",      dia: "Jueves",  hora: "7:00 p.m." },
  { nombre: "IEC Casa Blanca 2",                    lideres: "Antonio Torres",                   distrito: "Santiago de Surco",      dia: "Viernes", hora: "7:30 p.m." },
  { nombre: "IEC Villa El Salvador",                lideres: "Marcos Sulca & Julie Ávila",       distrito: "Villa El Salvador",      dia: "Jueves",  hora: "8:00 p.m." },
  { nombre: "IEC Villa María del Triunfo 2",        lideres: "Marcos Sulca & Julie Ávila",       distrito: "Villa María del Triunfo", dia: "Viernes", hora: "5:00 p.m." },
  { nombre: "IEC Lurín",                            lideres: "Jesús Hernández & Zuri",           distrito: "Lurín",                  dia: "Viernes", hora: "8:00 p.m." },
  { nombre: "IEC Huachipa",                         lideres: "David Castillo",                   distrito: "Huachipa",               dia: "Jueves",  hora: "7:30 p.m." },
  { nombre: "IEC Chorrillos 1",                     lideres: "Roni Decan & Mary Díaz",           distrito: "Chorrillos",             dia: "Jueves",  hora: "8:00 p.m." },
  { nombre: "IEC Villa María del Triunfo 1",        lideres: "Raquel Gamboa",                    distrito: "Villa María del Triunfo", dia: "Viernes", hora: "7:30 p.m." },
  { nombre: "IEC Chorrillos 2",                     lideres: "Danyelo Blanco & Karen",           distrito: "Chorrillos",             dia: "Jueves",  hora: "8:00 p.m." },
  { nombre: "IEC Monte Olivo",                      lideres: "Vicky Ampuero",                    distrito: "Santiago de Surco",      dia: "Jueves",  hora: "7:00 p.m." },
  { nombre: "IEC San Juan de Miraflores",           lideres: "José Espinoza & Damelis",          distrito: "San Juan de Miraflores", dia: "Jueves",  hora: "8:00 p.m." },
  { nombre: "IEC Santa Anita",                      lideres: "Yackelin Borjas",                  distrito: "Santa Anita",            dia: "Sábado",  hora: "7:00 p.m." },
  { nombre: "IEC Vista Alegre",                     lideres: "Nathalie Rivera",                  distrito: "Santiago de Surco",      dia: "Jueves",  hora: "8:00 p.m." },
  { nombre: "IEC San Miguel (Jóvenes)",             lideres: "Sofía Castillo",                   distrito: "San Miguel",             dia: "Viernes", hora: "8:00 p.m." },
  { nombre: "IEC Huachipa (Jóvenes)",               lideres: "Dina Castillo",                    distrito: "Huachipa",               dia: "Sábado",  hora: "10:00 a.m." },
  { nombre: "IEC Jicamarca",                        lideres: "Angely Sulca",                     distrito: "San Antonio",            dia: "Viernes", hora: "8:30 p.m." },
  { nombre: "IEC San Juan de Miraflores (Jóvenes)", lideres: "Víctor & Adriana Rojas",           distrito: "San Juan de Miraflores", dia: "Viernes", hora: "7:00 p.m." },
  { nombre: "IEC Cercado de Lima (Jóvenes)",        lideres: "Ariel Colonia & Mayerling Vega",   distrito: "Cercado de Lima",        dia: "Viernes", hora: "8:30 p.m." },
  { nombre: "IEC San Martín de Porres (Jóvenes)",   lideres: "Jean Cachay & Kiara Beltran",      distrito: "San Martín de Porres", dia: "Sábado",  hora: "8:00 p.m." },
  { nombre: "IEC Surco (Jóvenes)",                  lideres: "Andreina Blanco",                  distrito: "Santiago de Surco",      dia: "Jueves",  hora: "7:30 p.m." },
]

const diasSemana = [
  { code: "todos",     label: "Todos",     short: "Todos" },
  { code: "Lunes",     label: "Lunes",     short: "Lun" },
  { code: "Martes",    label: "Martes",    short: "Mar" },
  { code: "Miércoles", label: "Miércoles", short: "Mié" },
  { code: "Jueves",    label: "Jueves",    short: "Jue" },
  { code: "Viernes",   label: "Viernes",   short: "Vie" },
  { code: "Sábado",    label: "Sábado",    short: "Sáb" },
  { code: "Domingo",   label: "Domingo",   short: "Dom" },
]
const diasActivos = new Set(iecs.map((i) => i.dia))
---

<section id="iglesias-en-casa" class="relative pt-40 lg:pt-52 pb-24 lg:pb-32 bg-paper-50 overflow-hidden">
  {/* Trazado decorativo sutil de fondo */}
  <div class="absolute inset-0 pointer-events-none opacity-[0.04]" aria-hidden="true">
    <svg class="w-full h-full" preserveAspectRatio="xMidYMid slice" viewBox="0 0 1200 800" fill="none" stroke="currentColor" stroke-width="1">
      <circle cx="150" cy="180" r="140" />
      <circle cx="1050" cy="620" r="180" />
    </svg>
  </div>

  <div class="relative mx-auto max-w-[1400px] px-6 lg:px-10">
    {/* Header: título grande al lado del collage */}
    <div class="grid lg:grid-cols-[1fr_1.15fr] gap-10 lg:gap-16 items-center mb-16 lg:mb-20">
      <div>
        <p class="eyebrow mb-5">
          <span>05 · Iglesia en Casa</span>
        </p>
        <h2 class="font-display font-light text-[clamp(2.5rem,6vw,5.5rem)] leading-[1] text-ink-900 tracking-[-0.025em] text-balance">
          Llevando la Iglesia<br />
          <span class="italic text-spirit-500">a las casas.</span>
        </h2>
        <p class="mt-8 text-ink-500 text-lg max-w-lg leading-relaxed text-pretty">
          Grupos que se reúnen semanalmente en hogares de toda la ciudad —
          la Palabra compartida, la ministración uno-a-uno, la mesa abierta.
          El domingo latiendo en cada barrio.
        </p>
      </div>

      {/* Collage animado — 3 imágenes en composición asimétrica */}
      <div class="iec-collage relative aspect-[5/4] lg:aspect-[6/5]">
        <div class="iec-tile absolute top-0 left-[8%] w-[62%] h-[68%] rounded-[24px] overflow-hidden shadow-lg">
          <img src={collage[0].src} alt={collage[0].alt} class="w-full h-full object-cover" style={`object-position: ${collage[0].focal}`} loading="lazy" />
        </div>
        <div class="iec-tile iec-tile--2 absolute bottom-0 right-0 w-[52%] h-[58%] rounded-[24px] overflow-hidden shadow-xl ring-4 ring-paper-50">
          <img src={collage[1].src} alt={collage[1].alt} class="w-full h-full object-cover" style={`object-position: ${collage[1].focal}`} loading="lazy" />
        </div>
        <div class="iec-tile iec-tile--3 absolute top-[6%] right-[2%] w-[32%] h-[36%] rounded-[20px] overflow-hidden shadow-md ring-2 ring-paper-50">
          <img src={collage[2].src} alt={collage[2].alt} class="w-full h-full object-cover" style={`object-position: ${collage[2].focal}`} loading="lazy" />
        </div>
        <div class="absolute bottom-[8%] left-0 z-10 bg-ink-950 text-paper-50 rounded-full px-5 py-2.5 shadow-lg iec-chip">
          <div class="flex items-center gap-2.5">
            <span class="w-1.5 h-1.5 rounded-full bg-spirit-400 animate-pulse"></span>
            <span class="font-mono text-[10px] uppercase tracking-[0.25em]">Esta semana · en tu barrio</span>
          </div>
        </div>
      </div>
    </div>

    {/* CTA final — abre el modal con el directorio de IECs */}
    <div class="-mt-2 lg:mt-0 relative rounded-[28px] overflow-hidden bg-ink-950 text-paper-50 px-8 py-6 lg:px-12 lg:py-8">
      <div class="absolute inset-0 opacity-80 pointer-events-none">
        <div class="aurora-liquid aurora-strong"></div>
      </div>
      <div class="relative grid lg:grid-cols-[1fr_auto] gap-8 items-center">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-spirit-300 mb-3">
            / Sumate a una IEC
          </p>
          <p class="font-display font-light text-2xl lg:text-4xl leading-[1.15] text-balance max-w-2xl">
            Te presentamos al líder de la <span class="italic text-spirit-400">IEC más cercana</span> a ti — sin compromiso, sin cita previa.
          </p>
        </div>
        <button
          type="button"
          id="iec-open-btn"
          class="btn-primary shrink-0"
          aria-haspopup="dialog"
          aria-controls="iec-modal"
          data-cursor="hover"
        >
          <span>Encontrar mi IEC</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* ═══════════════════════════════════════════════════════════════════
      MODAL — Directorio de IECs con filtro por día.
      Se abre desde #iec-open-btn. Cierra con X, Esc, o click en backdrop.
      Bloquea scroll de body mientras está abierto. Focus trap básico.
      ═══════════════════════════════════════════════════════════════════ */}
  <div
    id="iec-modal"
    class="iec-modal fixed inset-0 z-[100] hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="iec-modal-title"
    aria-hidden="true"
  >
    {/* Backdrop */}
    <div class="iec-modal-backdrop absolute inset-0 bg-ink-950/70 backdrop-blur-md" data-iec-close></div>

    {/* Contenedor scrollable con centering en tablet+ */}
    <div class="absolute inset-0 flex items-end sm:items-center justify-center p-0 sm:p-6 pointer-events-none">
      <div class="iec-modal-content relative w-full sm:max-w-3xl bg-paper-50 rounded-t-[28px] sm:rounded-[28px] shadow-2xl max-h-[88dvh] sm:max-h-[85dvh] flex flex-col overflow-hidden pointer-events-auto">

        {/* Header sticky */}
        <div class="flex items-start justify-between gap-4 p-6 lg:p-8 border-b border-ink-900/10">
          <div class="min-w-0 flex-1">
            <p class="eyebrow mb-3">
              <span>05 · Iglesia en Casa</span>
            </p>
            <h3 id="iec-modal-title" class="font-display font-light text-2xl lg:text-3xl text-ink-900 tracking-[-0.02em] leading-tight">
              Reuniones <span class="italic text-spirit-500">esta semana</span>
            </h3>
          </div>
          <button
            type="button"
            class="shrink-0 w-10 h-10 rounded-full border border-ink-900/15 flex items-center justify-center text-ink-500 hover:bg-ink-900 hover:text-paper-50 hover:border-ink-900 transition-all"
            aria-label="Cerrar"
            data-iec-close
            data-cursor="hover"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
          </button>
        </div>

        {/* Filtro por día */}
        <div class="px-6 lg:px-8 py-5 border-b border-ink-900/10 bg-paper-100">
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-ink-400 mb-3">
            / Filtrar por día
          </p>
          <div class="flex items-center gap-2 flex-wrap" id="iec-filter">
            {diasSemana.map((d) => (
              <button
                type="button"
                data-day={d.code}
                class={`iec-day-btn inline-flex items-center justify-center px-4 py-2 rounded-full font-mono text-[11px] uppercase tracking-[0.2em] transition-all ${
                  d.code === "todos"
                    ? "bg-ink-900 text-paper-50"
                    : diasActivos.has(d.code)
                      ? "bg-paper-50 text-ink-900 border border-ink-900/15 hover:bg-ink-900 hover:text-paper-50 hover:border-ink-900"
                      : "bg-paper-50 text-ink-300 border border-ink-900/10 cursor-not-allowed opacity-50"
                }`}
                disabled={d.code !== "todos" && !diasActivos.has(d.code)}
                data-cursor={d.code === "todos" || diasActivos.has(d.code) ? "hover" : undefined}
              >
                <span class="hidden sm:inline">{d.label}</span>
                <span class="sm:hidden">{d.short}</span>
              </button>
            ))}
          </div>
        </div>

        {/* Lista de IECs — scrollable */}
        <div class="scroll-fine flex-1 overflow-y-auto px-6 lg:px-8 py-5">
          <ul id="iec-list" class="grid sm:grid-cols-2 gap-3">
            {iecs.map((iec, i) => (
              <li
                class="iec-card group relative p-5 rounded-[16px] border border-ink-900/8 hover:border-spirit-500/50 hover:shadow-md transition-all duration-400"
                data-day={iec.dia}
                style={`--i:${i}`}
                data-cursor="hover"
              >
                <div class="min-w-0">
                  {/* Eyebrow: día · hora */}
                  <div class="flex items-center gap-2 mb-3">
                    <span class="inline-flex items-center justify-center w-2 h-2 rounded-full bg-spirit-500 shrink-0"></span>
                    <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-spirit-500 truncate">
                      {iec.dia} · {iec.hora}
                    </p>
                  </div>

                  {/* Nombre de la IEC — título principal */}
                  <h4 class="font-display text-xl lg:text-2xl text-ink-900 tracking-[-0.02em] group-hover:italic transition-all duration-500 leading-tight">
                    {iec.nombre}
                  </h4>

                  {/* Líder(es) */}
                  <div class="mt-3 flex items-baseline gap-2">
                    <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-ink-400 shrink-0">
                      Líder(es)
                    </span>
                    <p class="text-ink-900 text-sm font-medium leading-snug truncate">
                      {iec.lideres}
                    </p>
                  </div>

                  {/* Distrito */}
                  <div class="mt-1.5 flex items-center gap-1.5 text-ink-500">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                    <p class="text-xs leading-snug truncate">
                      {iec.distrito}
                    </p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
          <p id="iec-empty" class="hidden text-center text-ink-400 font-mono text-sm uppercase tracking-[0.2em] mt-4 py-10">
            / Sin IECs este día — prueba otro
          </p>
        </div>

        {/* Footer con CTA de contacto */}
        <div class="p-6 lg:p-8 pb-[max(1.5rem,env(safe-area-inset-bottom))] border-t border-ink-900/10 bg-paper-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <p class="text-ink-500 text-sm max-w-md leading-snug">
            <span class="text-ink-900 font-medium">¿No encuentras una IEC cercana?</span><br class="hidden sm:block" />
            Escríbenos y te conectamos con el líder de la zona más próxima.
          </p>
          <a
            href="#contacto"
            class="btn-outline shrink-0"
            data-iec-close
            data-cursor="hover"
          >
            <span>Contáctanos</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </div>

  <style>
    /* Collage: cada tile flota suavemente con desfases distintos */
    .iec-tile { animation: iec-float 8s ease-in-out infinite; }
    .iec-tile--2 { animation-duration: 10s; animation-delay: -3s; }
    .iec-tile--3 { animation-duration: 7s; animation-delay: -5s; }
    @keyframes iec-float {
      0%, 100% { transform: translateY(0) rotate(0); }
      50%      { transform: translateY(-8px) rotate(-0.4deg); }
    }

    .iec-chip { animation: iec-chip-in 1s ease-out 0.3s backwards; }
    @keyframes iec-chip-in {
      from { opacity: 0; transform: translateY(20px) scale(0.9); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ═══════════════════════════════════════════════════════════
       Animaciones del modal — entrada y salida coreografiadas.
       ═══════════════════════════════════════════════════════════ */

    /* Estado "abierto" — activado por .is-open desde JS */
    .iec-modal.is-open {
      display: block;
    }

    /* Backdrop: fade + blur progresivo */
    .iec-modal-backdrop {
      opacity: 0;
      transition: opacity 0.35s ease-out;
    }
    .iec-modal.is-open .iec-modal-backdrop {
      opacity: 1;
    }

    /* Contenido: slide up + scale sutil */
    .iec-modal-content {
      opacity: 0;
      transform: translateY(40px) scale(0.97);
      transition:
        opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .iec-modal.is-open .iec-modal-content {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    /* Cards de IECs entran en cascada al abrir el modal.
       Escalonado corto y con tope, para que aun con muchas IECs la entrada sea rápida. */
    .iec-modal.is-open .iec-card {
      animation: iec-card-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) calc(min(var(--i, 0) * 0.018s, 0.36s)) backwards;
    }
    /* Una vez terminada la entrada, se desactiva la animación (clase la agrega el JS)
       para que al FILTRAR las cards aparezcan al instante, sin re-disparar la cascada. */
    .iec-modal.iec-cards-ready .iec-card {
      animation: none;
    }
    @keyframes iec-card-in {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Animación de salida — se aplica clase .is-closing temporalmente */
    .iec-modal.is-closing .iec-modal-backdrop {
      opacity: 0;
    }
    .iec-modal.is-closing .iec-modal-content {
      opacity: 0;
      transform: translateY(20px) scale(0.98);
    }

    /* Sheet mobile: entra desde abajo con más recorrido */
    @media (max-width: 640px) {
      .iec-modal-content {
        transform: translateY(100%);
      }
      .iec-modal.is-open .iec-modal-content {
        transform: translateY(0);
      }
      .iec-modal.is-closing .iec-modal-content {
        transform: translateY(100%);
      }
    }

    /* Bloqueo de scroll del body cuando el modal está abierto */
    body.iec-modal-open {
      overflow: hidden;
    }

    /* Reducir movimiento si el usuario lo prefiere */
    @media (prefers-reduced-motion: reduce) {
      .iec-tile, .iec-tile--2, .iec-tile--3, .iec-chip,
      .iec-modal-backdrop, .iec-modal-content,
      .iec-modal.is-open .iec-card {
        animation: none !important;
        transition: opacity 0.15s !important;
        transform: none !important;
      }
    }
  </style>

  <script>
    // ═══════════════════════════════════════════════════════════
    // Modal de IECs — apertura, cierre, filtro por día.
    // Los datos vienen del ERP si está configurado (fallback: datos fijos).
    // El filtro consulta el DOM en cada uso, así funciona igual con datos
    // fijos o con los que inyecta el ERP. Vanilla JS, accesible.
    // ═══════════════════════════════════════════════════════════
    import { erpEnabled, fetchIecs } from "../lib/erp"
    import type { IecPublic } from "../lib/erp"

    const modal = document.getElementById("iec-modal") as HTMLDivElement | null
    const openBtn = document.getElementById("iec-open-btn") as HTMLButtonElement | null
    const listEl = document.getElementById("iec-list")
    const filterWrap = document.getElementById("iec-filter")
    const emptyMsg = document.getElementById("iec-empty")

    let previousFocus: HTMLElement | null = null
    let readyTimer: ReturnType<typeof setTimeout> | undefined
    let currentDay = "todos"

    const esc = (s: unknown) =>
      String(s ?? "").replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string)

    // Genera el HTML de una card (mismo markup que el render de Astro)
    const cardHtml = (iec: IecPublic, i: number) => `
      <li class="iec-card group relative p-5 rounded-[16px] border border-ink-900/8 hover:border-spirit-500/50 hover:shadow-md transition-all duration-400" data-day="${esc(iec.dia)}" style="--i:${i}" data-cursor="hover">
        <div class="min-w-0">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-flex items-center justify-center w-2 h-2 rounded-full bg-spirit-500 shrink-0"></span>
            <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-spirit-500 truncate">${esc(iec.dia)}${iec.hora ? " · " + esc(iec.hora) : ""}</p>
          </div>
          <h4 class="font-display text-xl lg:text-2xl text-ink-900 tracking-[-0.02em] group-hover:italic transition-all duration-500 leading-tight">${esc(iec.nombre)}</h4>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-ink-400 shrink-0">Líder(es)</span>
            <p class="text-ink-900 text-sm font-medium leading-snug truncate">${esc(iec.lideres)}</p>
          </div>
          <div class="mt-1.5 flex items-center gap-1.5 text-ink-500">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
            <p class="text-xs leading-snug truncate">${esc(iec.distrito)}</p>
          </div>
        </div>
      </li>`

    // Habilita/deshabilita un pill de día según haya IECs ese día
    const setDayEnabled = (btn: HTMLButtonElement, enabled: boolean) => {
      btn.disabled = !enabled
      btn.classList.toggle("text-ink-300", !enabled)
      btn.classList.toggle("cursor-not-allowed", !enabled)
      btn.classList.toggle("opacity-50", !enabled)
      if (enabled) btn.setAttribute("data-cursor", "hover")
      else btn.removeAttribute("data-cursor")
    }

    const applyFilter = (day: string) => {
      currentDay = day
      const cards = modal?.querySelectorAll<HTMLLIElement>(".iec-card") ?? []
      let visibleCount = 0
      cards.forEach((card) => {
        const show = day === "todos" || (card.dataset.day ?? "") === day
        card.style.display = show ? "" : "none"
        if (show) visibleCount++
      })
      emptyMsg?.classList.toggle("hidden", visibleCount > 0)

      // Estado visual de los pills (se consultan frescos del DOM)
      const allBtns = modal?.querySelectorAll<HTMLButtonElement>(".iec-day-btn") ?? []
      allBtns.forEach((b) => {
        const isActive = b.dataset.day === day
        b.classList.toggle("bg-ink-900", isActive)
        b.classList.toggle("text-paper-50", isActive)
        b.classList.toggle("bg-paper-50", !isActive)
        b.classList.toggle("text-ink-900", !isActive && !b.disabled)
        b.classList.toggle("border", !isActive)
        b.classList.toggle("border-ink-900/15", !isActive && !b.disabled)
      })
    }

    const openModal = () => {
      if (!modal) return
      previousFocus = document.activeElement as HTMLElement | null
      modal.classList.remove("is-closing")
      modal.classList.remove("iec-cards-ready")
      modal.classList.add("is-open")
      modal.setAttribute("aria-hidden", "false")
      document.body.classList.add("iec-modal-open")
      applyFilter("todos")
      clearTimeout(readyTimer)
      readyTimer = setTimeout(() => modal.classList.add("iec-cards-ready"), 850)
      requestAnimationFrame(() => {
        const closeBtn = modal.querySelector<HTMLButtonElement>("[data-iec-close]")
        closeBtn?.focus()
      })
    }

    const closeModal = () => {
      if (!modal) return
      modal.classList.add("is-closing")
      modal.classList.remove("is-open")
      modal.setAttribute("aria-hidden", "true")
      document.body.classList.remove("iec-modal-open")
      clearTimeout(readyTimer)
      modal.classList.remove("iec-cards-ready")
      setTimeout(() => modal.classList.remove("is-closing"), 500)
      previousFocus?.focus()
    }

    // Wire up: abrir / cerrar
    openBtn?.addEventListener("click", openModal)
    modal?.querySelectorAll<HTMLElement>("[data-iec-close]").forEach((el) => {
      el.addEventListener("click", (e) => {
        if (el.tagName !== "A") e.preventDefault()
        closeModal()
      })
    })
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal?.classList.contains("is-open")) closeModal()
    })

    // Wire up: filtros por día (delegación → sigue funcionando aunque
    // los pills se re-habiliten al llegar datos del ERP)
    filterWrap?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".iec-day-btn")
      if (!btn || btn.disabled || !filterWrap.contains(btn)) return
      applyFilter(btn.dataset.day ?? "todos")
    })

    // ── Auto-conexión con el ERP: si responde con IECs, reemplaza el
    //    contenido fijo. Si no (ERP offline o sin datos), se queda el fallback.
    ;(async () => {
      if (!erpEnabled() || !listEl || !filterWrap) return
      const items = await fetchIecs()
      if (!items || items.length === 0) return
      listEl.innerHTML = items.map((iec, i) => cardHtml(iec, i)).join("")
      const activos = new Set(items.map((i) => i.dia))
      filterWrap.querySelectorAll<HTMLButtonElement>(".iec-day-btn").forEach((btn) => {
        const day = btn.dataset.day ?? ""
        if (day === "todos") return
        setDayEnabled(btn, activos.has(day))
      })
      applyFilter(currentDay)
    })()
  </script>
</section>
