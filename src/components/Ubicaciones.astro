---
import NumberTicker from "./NumberTicker.tsx"

const sedes = [
  { ciudad: "Surco", pais: "Perú", nombre: "Sede Central", direccion: "Manuel Aguila Durand 280", principal: true, proximamente: false },
  { ciudad: "Pichanaki", pais: "Perú", nombre: "Renacer Pampa Julián", direccion: "Pampa Julián - Pichanaki", principal: false, proximamente: false },
  { ciudad: "", pais: "", nombre: "Próximamente", direccion: "", principal: false, proximamente: true },
  { ciudad: "", pais: "", nombre: "Próximamente", direccion: "", principal: false, proximamente: true },
]
---

<section id="ubicaciones" class="relative py-32 lg:py-44 bg-paper-50">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-16 lg:gap-24 items-start">
      <div class="lg:sticky lg:top-32">
        <p class="eyebrow mb-6">
          <span>07 · Un mismo sentir, un cuerpo</span>
        </p>
        <h2 class="font-display font-light text-[clamp(2.5rem,6vw,6rem)] leading-[1] text-ink-900 tracking-[-0.025em] text-balance">
          Renacer en<br />
          <span class="italic text-spirit-500">cada ciudad.</span>
        </h2>
        <p class="mt-8 text-ink-500 text-lg max-w-md leading-relaxed">
          Red de iglesias unidas por la misma visión: ver vidas que renacen y
          comunidades transformadas en todo el Perú.
        </p>

        <div class="mt-14 grid grid-cols-3 gap-6 max-w-md border-t border-ink-900/10 pt-10">
          <div>
            <p class="font-display text-6xl text-ink-900 leading-none">
              <NumberTicker client:visible value={2} />
            </p>
            <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-ink-400 mt-2">Sedes</p>
          </div>
          <div>
            <p class="font-display text-6xl text-ink-900 leading-none">
              <NumberTicker client:visible value={5} />
            </p>
            <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-ink-400 mt-2">Pastores</p>
          </div>
          <div>
            <p class="font-display text-6xl text-spirit-500 leading-none italic">
              ∞
            </p>
            <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-ink-400 mt-2">Reino</p>
          </div>
        </div>
      </div>

      <ul class="space-y-3">
        {sedes.map((s) => (
          s.proximamente ? (
            <li class="bento p-7 lg:p-8 flex items-center justify-between gap-6 border-dashed opacity-70">
              <h3 class="font-display text-2xl lg:text-3xl text-ink-300 tracking-[-0.02em] italic">
                Próximamente
              </h3>
              <span class="shrink-0 text-ink-300">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
                </svg>
              </span>
            </li>
          ) : (
            <li class={`group bento p-7 lg:p-8 flex items-start justify-between gap-6 ${s.principal ? '!border-spirit-500' : ''}`} data-cursor="hover">
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-spirit-500 mb-2">
                  {s.ciudad}, {s.pais}
                </p>
                <h3 class="font-display text-3xl lg:text-4xl text-ink-900 tracking-[-0.02em] mb-2 group-hover:italic transition-all duration-500">
                  {s.nombre}
                </h3>
                <p class="text-ink-500 text-sm">{s.direccion}</p>
              </div>
              {s.principal ? (
                <span class="shrink-0 font-mono text-[10px] uppercase tracking-[0.3em] text-ink-900 px-2.5 py-1 rounded-full bg-spirit-500">
                  Central
                </span>
              ) : (
                <span class="shrink-0 text-ink-300 group-hover:text-spirit-500 transition-colors duration-500">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M7 17L17 7M9 7h8v8" />
                  </svg>
                </span>
              )}
            </li>
          )
        ))}
      </ul>
    </div>
  </div>
</section>
