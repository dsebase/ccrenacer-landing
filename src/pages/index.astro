---
import Layout from "../layouts/Layout.astro"
import Hero from "../components/Hero.tsx"
import Marquee from "../components/Marquee.astro"
import Manifiesto from "../components/Manifiesto.tsx"
import ScrollStory from "../components/ScrollStory.tsx"
import Vision from "../components/Vision.tsx"
import Servicios from "../components/Servicios.astro"
import Ministerios from "../components/Ministerios.tsx"
import Ubicaciones from "../components/Ubicaciones.astro"
import Dar from "../components/Dar.astro"
import CTASistema from "../components/CTASistema.tsx"
import Contacto from "../components/Contacto.astro"
import { images, media } from "../lib/images"

const sistemaUrl = import.meta.env.PUBLIC_SISTEMA_URL ?? "https://sistema.ccrenacer.com"

const stages = [
  {
    n: "I",
    title: "Educación Cristiana.",
    italic: "Renacer I a III.",
    desc: "Es nuestro deseo como iglesia enseñar los principios bíblicos en los cuales se fundamenta nuestra fe. Tenemos la responsabilidad ante Dios de fortalecer los primeros pasos en el crecimiento espiritual de la vida cristiana. Toda persona que ha reconocido a Jesucristo como su Señor y Salvador personal, es de suma importancia que pase por un proceso de enseñanza-aprendizaje. El programa de educación cristiana en nuestra Comunidad Cristiana Renacer tiene un desarrollo integral, viendo a cada creyente desde su primer paso en la fe, con nuestro libro Renacer 1 hasta Renacer 3.",
    img: images.encuentro,
    verse: "Estando persuadido de esto, que el que comenzó en vosotros la buena obra, la perfeccionará hasta el día de Jesucristo.",
    verseRef: "Filipenses 1:6",
    cta: "Quiero inscribirme",
  },
  {
    n: "II",
    title: "Escuela de Líderes.",
    italic: "Formación ministerial.",
    desc: "La Escuela de Líderes Renacer es un programa de capacitación bíblica y formación ministerial dirigido a los líderes y servidores de la Iglesia Comunidad Cristiana Renacer. Su objetivo principal es preparar, afirmar y equipar a hombres y mujeres llamados por Dios para servir con excelencia en la obra del ministerio, convirtiéndose en instrumentos útiles para la edificación del Cuerpo de Cristo, el fortalecimiento de la iglesia local y la extensión del Reino de Dios. Esta escuela nace con el propósito de formar líderes con fundamento bíblico, carácter cristiano, visión espiritual y compromiso con la misión de la iglesia.",
    img: images.discipulado,
    verse: "Formar líderes con fundamento bíblico, carácter cristiano, visión espiritual y compromiso con la misión de la iglesia.",
    verseRef: "Propósito",
    cta: "Quiero formarme",
  },
  {
    n: "III",
    title: "Seminario Teológico.",
    italic: "Renacer.",
    desc: "En su deseo de seguir formando hombres y mujeres bajo la enseñanza de las Escrituras, cuidando siempre el desarrollo del fruto del Espíritu Santo y la manifestación de los dones espirituales en cada persona, nace el Seminario Teológico Renacer, con la firme convicción de que su alcance formativo y espiritual sea de bendición al Cuerpo de Cristo y a la sociedad. En la actualidad se ha establecido un convenio con Dayspring Theological University para certificar en estudios teológicos a todos los alumnos del seminario.",
    img: images.envio,
    verse: "Preparando líderes para los retos de la iglesia y de la sociedad.",
    verseRef: "Seminario Renacer",
    cta: "Conoce el seminario",
  },
]

const ministerios = [
  {
    n: "M.01",
    nombre: "Familia",
    desc: "Matrimonios y familias que construyen hogares fundados en Cristo.",
    img: images.familias,
    size: "wide" as const,
    objectPos: "center 30%", // baja el encuadre para no cortar las caras
  },
  {
    n: "M.02",
    nombre: "Intercesión",
    desc: "Guerreros de oración que sostienen la visión en la presencia de Dios.",
    img: images.misiones,
    size: "tall" as const,
  },
  {
    n: "M.03",
    nombre: "RNCR Kids",
    desc: "Formamos a los más pequeños en el conocimiento de Jesús.",
    img: images.ninos,
    size: "square" as const,
  },
  {
    n: "M.04",
    nombre: "Jóvenes",
    desc: "Una generación encendida viviendo la fe en la universidad y la calle.",
    img: images.jovenes,
    size: "square" as const,
  },
  {
    n: "M.05",
    nombre: "Alabanza & Adoración",
    desc: "Músicos y adoradores al servicio de la presencia de Dios.",
    img: images.adoracionMin,
    size: "wide" as const,
    objectPos: "center 22%", // muestra más arriba de la foto (no corta la cabeza)
    flip: true,              // espeja: la persona principal mira a la izquierda
  },
  {
    n: "M.06",
    nombre: "Multimedia",
    desc: "Creativos, técnicos y comunicadores que amplifican el mensaje.",
    img: images.social,
    size: "square" as const,
  },
]

---

<Layout>
  <Hero client:load sistemaUrl={sistemaUrl} heroImg={images.hero} />
  <Marquee variant="light" />
  <Manifiesto
    client:visible
    videoSrc={media.manifiestoVideo}
    videoWebm={media.manifiestoVideoWebm}
    poster={media.manifiestoPoster}
  />
  <Servicios />
  <Vision client:visible />
  <ScrollStory client:load stages={stages} />
  <Ministerios client:visible ministerios={ministerios} />
  <Ubicaciones />
  <Dar />
  {/* SECCIÓN "Sistema interno" OCULTA (iría como 09, entre Dar y Contacto).
      Para volver a mostrarla: descomentá la línea de abajo (quitá el {/* y * /})
      y, en Contacto.astro, cambiá el número del eyebrow de "09 · Contacto" a "10 · Contacto".
      En CTASistema.tsx el eyebrow ya quedó como "09 · Sistema interno". */}
  {/* <CTASistema client:visible sistemaUrl={sistemaUrl} bgImg={images.sistema} /> */}
  <Contacto />
</Layout>
